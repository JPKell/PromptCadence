{"$id":"https://promptcadence.local/schemas/plan/1.0.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"A plan of steps over a DAG. Tools, tier and data_classification are declarations that approval turns into one immutable ExecutionIntent per step; description and expected_turns are advisory.","properties":{"steps":{"items":{"additionalProperties":false,"properties":{"data_classification":{"enum":["public","internal","confidential"],"type":"string"},"depends_on":{"items":{"maxLength":64,"minLength":1,"type":"string"},"type":"array"},"description":{"maxLength":2000,"minLength":1,"type":"string"},"expected_turns":{"maximum":100,"minimum":1,"type":"integer"},"step_id":{"maxLength":64,"minLength":1,"type":"string"},"tier":{"maxLength":60,"minLength":1,"type":"string"},"tools":{"items":{"maxLength":64,"minLength":1,"type":"string"},"type":"array"}},"required":["step_id","description","depends_on","tools","tier","data_classification","expected_turns"],"type":"object"},"minItems":1,"type":"array"}},"required":["steps"],"title":"PromptCadence plan","type":"object"}
